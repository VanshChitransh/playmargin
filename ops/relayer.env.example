# Relayer env on the droplet: /etc/margin/relayer.env (root:margin-relayer, chmod 640). Never committed.
# The relayer runs as margin-relayer and the game server as margin, so neither can read the other's key.

NETWORK=testnet
CONTRACT_ID=playmargin.testnet
USDC_ID=usdc.playmargin.testnet
RELAYER_ID=relayer.playmargin.testnet
# ed25519:... full key of the relayer account. Only on the droplet.
RELAYER_PRIVATE_KEY=
RELAYER_PORT=3030
# Only the game site may call it from a browser.
RELAYER_CORS_ORIGIN=https://playmargin.fun,https://www.playmargin.fun
# GET /relay/health raises alarm below this many NEAR (0.05 on the lean mainnet budget).
RELAYER_LOW_BALANCE=0.5

# 1-Click (Add funds). Live deposits only with ONECLICK_LIVE=1.
ONECLICK_JWT=
ONECLICK_LIVE=
ONECLICK_RECIPIENT=

# Email accounts (NEAR Auth): NEAR funded per new account and a daily cap.
FASTAUTH_FUND=
FASTAUTH_DAILY_CAP=
