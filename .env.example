# Copy to .env (never committed). Every variable the repo reads is listed here.

# testnet | mainnet. One switch for every NEAR call (DEVELOPMENT.md: mainnet from Day 4).
NETWORK=testnet

# NEAR AI Cloud key from nearbuilders.org/dashboard (agent commander A6, npm run commander).
NEAR_AI_API_KEY=

# Colyseus monitor at /colyseus is mounted only when this is set (user: admin).
MONITOR_PASS=

# Client: game server URL. Empty = same host as the page on port 2567.
VITE_SERVER_URL=

# Server and settlement vars (CONTRACT_ID, SETTLER_ID, SETTLER_PRIVATE_KEY, RPC_URLS, DB_PATH, PORT):
# see ops/env.example for the full list.
