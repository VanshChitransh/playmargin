# EC2 mode (live since 13 Nov): api.playmargin.fun behind Cloudflare's proxy (orange cloud), box in ap-south-1.
# Install: sudo cp ops/Caddyfile.cloudflare /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Needs the cloudflare DNS module (sudo caddy add-package github.com/caddy-dns/cloudflare) and the token in
# /etc/caddy/cf.env (CF_API_TOKEN=..., root 600) loaded by a caddy.service drop-in. See ops/README.md "EC2 mode".
# trusted_proxies = Cloudflare's published ranges (www.cloudflare.com/ips-v4 and ips-v6, 13 Nov 2026): refresh
# if they change, or client IPs fall back to the edge's and every player shares one rate limit bucket.
# EC2 (Mumbai) behind Cloudflare's proxy. TLS: Let's Encrypt via DNS-01 (caddy-dns/cloudflare), so the
# cert is valid in any Cloudflare SSL mode. Port 80 serves too (no redirect): Cloudflare's edge handles
# HTTPS for players, and a Flexible zone would otherwise loop. The client IP is CF-Connecting-IP, believed
# only from Cloudflare's published ranges, so a direct hit on the box cannot forge it.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}
api.playmargin.fun, http://api.playmargin.fun {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode gzip
	handle_path /relay/* {
		reverse_proxy localhost:3030 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	reverse_proxy localhost:2567 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}
