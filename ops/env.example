# Server env on the droplet: /etc/margin/env (root:margin, chmod 640). Never committed with values.

# Game server (Colyseus + read API).
PORT=2567
DB_PATH=/var/lib/margin/margin.sqlite
# Colyseus monitor at /colyseus, only mounted when set (user: admin).
MONITOR_PASS=

# Chain. testnet until Vansh approves mainnet (DEVELOPMENT.md S10).
NETWORK=testnet
CONTRACT_ID=playmargin.testnet
SETTLER_ID=settler.playmargin.testnet
# ed25519:... full key of the settler account. Only on the droplet. Without it paid rooms are off
# and the hourly anchor keeps roots locally until a key is present.
SETTLER_PRIVATE_KEY=
# Comma list, keyed provider first; a public FastNEAR fallback is always appended.
RPC_URLS=

# Agents commander (Phase 3).
NEAR_AI_API_KEY=

# Live room cap per process (default 100 = 1,200 seats)
MAX_ROOMS=100
# Joins per minute per IP (default 12). Only load tests from one machine need more.
JOIN_LIMIT_PER_MIN=12

# Relayer (services/relayer): its OWN process and its OWN env file (e.g. /etc/margin/relayer.env).
# Never put RELAYER_PRIVATE_KEY in the game server's env: the two keys stay apart.
RELAYER_ID=relayer.playmargin.testnet
# ed25519:... full key of the relayer account. Locally the relayer reads ~/.near-credentials.
RELAYER_PRIVATE_KEY=
RELAYER_PORT=3030
# The relayer reads RPC_URLS too: these first, then FastNEAR, then rpc.<network>.near.org.
RELAYER_CORS_ORIGIN=https://playmargin.fun,https://www.playmargin.fun
# /health raises alarm below this many NEAR.
RELAYER_LOW_BALANCE=0.5
# 1-Click (NEAR Intents) Add funds. JWT from partners.near-intents.org, server side only.
ONECLICK_JWT=
# Quotes are DRY (real prices, no deposit address) unless ONECLICK_LIVE=1, which is refused unless
# NETWORK=mainnet. Dry quotes need a recipient that exists on mainnet and default to
# vanshverse.near. Live quotes default to CONTRACT_ID: set ONECLICK_RECIPIENT only to override.
ONECLICK_LIVE=
ONECLICK_RECIPIENT=
# /relay limits: paid relays per minute and per UTC day (GET /health raises alarm when hit).
RELAYER_MINUTE_CAP=60
RELAYER_DAILY_CAP=2000
# Email login (NEAR Auth) routes are OFF unless FASTAUTH_ENABLED=1. Turn on only after NEAR approves
# our Auth0 app AND the relayer verifies the Auth0 JWT before paying (not built yet).
FASTAUTH_ENABLED=
# NEAR given to each new email account, and new accounts per day.
FASTAUTH_FUND=0.01
FASTAUTH_DAILY_CAP=200
