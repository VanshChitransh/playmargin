{
  "name": "playmargin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w @margin/server\" \"npm run dev -w @margin/client\"",
    "build": "npm run build -w @margin/client",
    "test": "vitest run --passWithNoTests",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "check:dashes": "! git grep -nIP '[\\x{2013}\\x{2014}]' -- . ':!package-lock.json'",
    "demo": "tsx tools/sim/demo.ts",
    "sim": "tsx tools/sim/sim.ts",
    "soak": "tsx tools/sim/soak.ts",
    "sweep": "tsx tools/sim/sweep.ts",
    "commander": "tsx --env-file-if-exists=.env tools/sim/commander-live.ts",
    "e2e:local": "npm run e2e -w @margin/server"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
