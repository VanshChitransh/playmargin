# Hashed build files never change, so they cache forever. A missing one is a real 404 (dist/404.html
# turns off the Pages SPA fallback), never index.html served as CSS or JS.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# No framing (clickjacking), no MIME sniffing, HTTPS only, and no full URL (with a ?key=) in Referer.
# No script CSP: wallet pop-ups and the analytics beacon load their own scripts.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
