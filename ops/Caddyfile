# Live config (EC2, since 13 Nov): api.playmargin.fun is DNS-only (grey cloud), players hit Caddy directly.
# Caddy terminates TLS and proxies HTTP + WebSocket to Colyseus. HTTP redirects to HTTPS.
# Install: sudo cp ops/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# The cert comes from Let's Encrypt via DNS-01 (caddy-dns/cloudflare, token in /etc/caddy/cf.env), so it
# renews whether or not the record is proxied. With no proxy in front, the client IP is the TCP peer
# ({remote_host}): no header from the client is believed. Orange cloud instead? Use ops/Caddyfile.cloudflare.
api.playmargin.fun {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode gzip
	# B08: HTTPS only from now on (HSTS), no MIME sniffing, and Express does not announce itself.
	# defer: applied after the proxy, so it also strips the upstream X-Powered-By.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-X-Powered-By
		defer
	}
	# Relayer (S4, services/relayer): https://api.playmargin.fun/relay/<route> -> localhost:3030/<route>.
	# Client: VITE_RELAYER_URL=https://api.playmargin.fun/relay. It rate-limits by X-Forwarded-For: set it here.
	handle_path /relay/* {
		reverse_proxy localhost:3030 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# The server rate-limits joins AND seat reservations (POST /matchmake, apps/server/src/matchmakeGuard.ts)
	# by X-Real-IP: set it here so a client can't send its own. Stock Caddy has no rate_limit directive
	# (it is the caddy-ratelimit plugin, not in the apt package), so the limit lives in the server.
	reverse_proxy localhost:2567 {
		header_up X-Real-IP {remote_host}
	}
}
